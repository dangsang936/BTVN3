# Sao chép thành .env rồi điền key thật. KHÔNG commit file .env.
SUPPLIER=google                 # google | openai | anthropic
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# Đơn giá (USD / 1 triệu token) để ước tính chi phí trong harness/budget.py
PRICE_INPUT_PER_M=0.10
PRICE_OUTPUT_PER_M=0.40
# Generation parameters (load.py): temperature thấp -> output ổn định; max_tokens giới hạn độ dài output mỗi lần gọi
# Gemini 3.x bỏ qua temperature (sampling cố định) nên load.py không gửi tham số này cho các model đó
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=1024
